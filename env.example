NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImN5bWV3bm9raXpjd2FoYW1yd3RuIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjQ5NjUwMjksImV4cCI6MjA4MDU0MTAyOX0.s_TaAvWdE3FOgj0e88oscFYU1STqRgJdkL5uj-4hT0U
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # Usado apenas para webhooks

# Stripe
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Google OAuth (Para Calendar, Meet e Gmail)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron Jobs (para proteger endpoints de cron)
# Use um valor seguro e aleatório. Exemplo: openssl rand -hex 32
# Este token é usado para autenticar chamadas do cron-job.org
CRON_SECRET=your-random-secret-for-cron

# WhatsApp centralizado — Meta Cloud API (WABA única da plataforma)
# Liga o canal WhatsApp. Sem "true" tudo cai no fallback de e-mail.
WHATSAPP_PLATFORM_ENABLED=false
# WhatsApp Manager > Contas do WhatsApp Business
META_WABA_ID=
# WhatsApp Manager > Números de telefone > ID do número de telefone
META_PHONE_NUMBER_ID=
# Token permanente do System User com whatsapp_business_messaging
META_ACCESS_TOKEN=
# App Dashboard > Configurações > Básico > Chave secreta do app (valida o webhook)
META_APP_SECRET=
# Valor que você escolhe e repete ao cadastrar o webhook na Meta
META_WEBHOOK_VERIFY_TOKEN=
# Opcional: sobrescreve os nomes dos templates aprovados
META_TEMPLATE_CONFIRMATION=appointment_confirmation
META_TEMPLATE_REMINDER_24H=appointment_reminder_24h
META_TEMPLATE_REMINDER_2H=appointment_reminder_2h
# Opcional: só preencha se cadastrar um template para o link do Meet
META_TEMPLATE_MEET_LINK=
META_TEMPLATE_LANGUAGE=pt_BR
# Opcional: versão da Graph API (default v21.0)
META_GRAPH_VERSION=v21.0

# Correios — API Busca CEP (serviço 86738 no contrato comercial)
# Sem estas variáveis o autocomplete usa BrasilAPI como fallback.
# Manual: https://www.correios.com.br/atendimento/developers/manuais/manual-api-busca-cep
CORREIOS_API_URL=https://api.correios.com.br
CORREIOS_USER=
CORREIOS_ACCESS_CODE=
CORREIOS_CONTRACT_NUMBER=

# Criptografia do prontuário e das notas clínicas (AES-256-GCM).
# 32 bytes em hex (64 caracteres). Sem esta variável o app grava em claro.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RECORDS_ENCRYPTION_KEY=